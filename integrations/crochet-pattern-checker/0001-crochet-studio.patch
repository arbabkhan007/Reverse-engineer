+/* YarnCraft Studio - design tokens and layout */
+
+:root {
+  --cream: #fbf6ec;
+  --paper: #fffdf8;
+  --ink: #2c2519;
+  --ink-soft: #6b6155;
+  --ink-faint: #9a9184;
+  --line: #e8dfcd;
+  --line-strong: #d8cbb2;
+  --terracotta: #c2643c;
+  --terracotta-dark: #a4512e;
+  --terracotta-soft: #f6e3d8;
+  --sage: #6d8a6a;
+  --sage-soft: #e5ece2;
+  --mustard: #d9a13b;
+  --mustard-soft: #faeed3;
+  --rose: #b5525f;
+  --rose-soft: #f8e2e4;
+  --sky: #4b7f96;
+  --sky-soft: #e0edf2;
+  --radius: 16px;
+  --radius-sm: 10px;
+  --radius-lg: 26px;
+  --shadow-sm: 0 1px 2px rgba(44, 37, 25, 0.06), 0 2px 8px rgba(44, 37, 25, 0.04);
+  --shadow: 0 4px 14px rgba(44, 37, 25, 0.08), 0 1px 3px rgba(44, 37, 25, 0.05);
+  --shadow-lg: 0 18px 44px rgba(44, 37, 25, 0.13);
+  --font: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Georgia', ui-serif, serif;
+  --font-ui: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
+  --font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
+  --max: 1180px;
+}
+
+* { box-sizing: border-box; }
+
+html, body { margin: 0; padding: 0; }
+
+body {
+  background:
+    radial-gradient(circle at 12% 4%, rgba(217, 161, 59, 0.09), transparent 42%),
+    radial-gradient(circle at 88% 0%, rgba(194, 100, 60, 0.08), transparent 38%),
+    var(--cream);
+  color: var(--ink);
+  font-family: var(--font-ui);
+  font-size: 16px;
+  line-height: 1.55;
+  -webkit-font-smoothing: antialiased;
+  min-height: 100vh;
+}
+
+h1, h2, h3, h4 {
+  font-family: var(--font);
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  margin: 0 0 0.4em;
+  line-height: 1.2;
+}
+h1 { font-size: clamp(1.9rem, 4vw, 2.7rem); }
+h2 { font-size: clamp(1.35rem, 2.4vw, 1.75rem); }
+h3 { font-size: 1.18rem; }
+h4 { font-size: 1rem; }
+p { margin: 0 0 1em; }
+a { color: var(--terracotta-dark); text-decoration: none; }
+a:hover { text-decoration: underline; }
+img { max-width: 100%; display: block; }
+button, input, select, textarea { font: inherit; color: inherit; }
+:focus-visible { outline: 3px solid rgba(194, 100, 60, 0.45); outline-offset: 2px; border-radius: 6px; }
+
+/* ------------------------------------------------------------------ layout */
+
+.app { display: flex; flex-direction: column; min-height: 100vh; }
+
+.topbar {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  background: rgba(251, 246, 236, 0.9);
+  backdrop-filter: blur(14px);
+  border-bottom: 1px solid var(--line);
+}
+.topbar-inner {
+  max-width: var(--max);
+  margin: 0 auto;
+  padding: 12px 20px;
+  display: flex;
+  align-items: center;
+  gap: 18px;
+}
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-family: var(--font);
+  font-size: 1.22rem;
+  font-weight: 600;
+  color: var(--ink);
+  white-space: nowrap;
+}
+.brand:hover { text-decoration: none; }
+.brand-mark {
+  width: 34px; height: 34px;
+  border-radius: 12px;
+  background: linear-gradient(140deg, var(--terracotta), var(--mustard));
+  display: grid; place-items: center;
+  color: #fff; font-size: 17px;
+  box-shadow: var(--shadow-sm);
+}
+.brand small { display: block; font-family: var(--font-ui); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); font-weight: 600; }
+
+.nav { display: flex; gap: 2px; flex-wrap: wrap; margin-left: auto; }
+.nav a {
+  padding: 7px 12px;
+  border-radius: 999px;
+  color: var(--ink-soft);
+  font-size: 0.88rem;
+  font-weight: 550;
+  white-space: nowrap;
+}
+.nav a:hover { background: rgba(232, 223, 205, 0.6); text-decoration: none; color: var(--ink); }
+.nav a.active { background: var(--ink); color: var(--cream); }
+
+.main { flex: 1; max-width: var(--max); width: 100%; margin: 0 auto; padding: 28px 20px 80px; }
+
+.page-head { margin-bottom: 24px; }
+.page-head .eyebrow {
+  font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;
+  color: var(--terracotta); font-weight: 700; margin-bottom: 6px;
+}
+.page-head p.lead { color: var(--ink-soft); max-width: 62ch; margin: 0; }
+
+.stack { display: flex; flex-direction: column; gap: 16px; }
+.row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
+.row-tight { display: flex; gap: 6px; align-items: center; }
+.spacer { flex: 1; }
+.grid { display: grid; gap: 16px; }
+.grid-2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
+.grid-3 { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
+.grid-4 { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
+.split { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 24px; align-items: start; }
+@media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
+
+/* ------------------------------------------------------------------ cards */
+
+.card {
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 20px;
+  box-shadow: var(--shadow-sm);
+}
+.card.flush { padding: 0; overflow: hidden; }
+.card-title { display: flex; align-items: baseline; gap: 10px; margin-bottom: 12px; }
+.card-title h3 { margin: 0; }
+.card-title .meta { color: var(--ink-faint); font-size: 0.8rem; margin-left: auto; }
+
+.pattern-card {
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  overflow: hidden;
+  box-shadow: var(--shadow-sm);
+  display: flex;
+  flex-direction: column;
+  transition: transform 0.16s ease, box-shadow 0.16s ease;
+}
+.pattern-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
+.pattern-card .thumb {
+  height: 116px;
+  display: grid;
+  place-items: center;
+  position: relative;
+  background: var(--terracotta-soft);
+}
+.pattern-card .thumb svg { height: 82px; width: auto; opacity: 0.92; }
+.pattern-card .body { padding: 13px 15px 15px; display: flex; flex-direction: column; gap: 7px; flex: 1; }
+.pattern-card h4 { margin: 0; font-family: var(--font); font-size: 1.02rem; line-height: 1.3; }
+.pattern-card .blurb { font-size: 0.82rem; color: var(--ink-soft); margin: 0; flex: 1; }
+.pattern-card .foot { display: flex; gap: 8px; align-items: center; font-size: 0.76rem; color: var(--ink-faint); }
+
+/* ------------------------------------------------------------------ chips */
+
+.chip {
+  display: inline-flex; align-items: center; gap: 5px;
+  padding: 3px 9px; border-radius: 999px;
+  font-size: 0.73rem; font-weight: 600;
+  background: var(--line);
+  color: var(--ink-soft);
+  white-space: nowrap;
+  border: 1px solid transparent;
+}
+.chip.terracotta { background: var(--terracotta-soft); color: var(--terracotta-dark); }
+.chip.sage { background: var(--sage-soft); color: #3f5a3d; }
+.chip.mustard { background: var(--mustard-soft); color: #8a6216; }
+.chip.rose { background: var(--rose-soft); color: #8d3a46; }
+.chip.sky { background: var(--sky-soft); color: #2f5c70; }
+.chip.outline { background: transparent; border-color: var(--line-strong); color: var(--ink-soft); }
+
+/* ------------------------------------------------------------------ buttons */
+
+.btn {
+  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
+  padding: 9px 16px;
+  border-radius: 999px;
+  border: 1px solid var(--line-strong);
+  background: var(--paper);
+  color: var(--ink);
+  font-size: 0.89rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: background 0.14s ease, border-color 0.14s ease, transform 0.1s ease;
+  text-decoration: none;
+}
+.btn:hover { background: #f6f1e6; text-decoration: none; }
+.btn:active { transform: scale(0.98); }
+.btn.primary { background: var(--terracotta); border-color: var(--terracotta); color: #fff; }
+.btn.primary:hover { background: var(--terracotta-dark); border-color: var(--terracotta-dark); }
+.btn.dark { background: var(--ink); border-color: var(--ink); color: var(--cream); }
+.btn.dark:hover { background: #41382a; }
+.btn.ghost { background: transparent; border-color: transparent; color: var(--ink-soft); }
+.btn.ghost:hover { background: rgba(232, 223, 205, 0.55); }
+.btn.sm { padding: 5px 11px; font-size: 0.79rem; }
+.btn.lg { padding: 12px 22px; font-size: 0.98rem; }
+.btn.block { width: 100%; }
+.btn:disabled { opacity: 0.5; cursor: not-allowed; }
+.btn.danger { color: var(--rose); border-color: var(--rose-soft); }
+.btn.danger:hover { background: var(--rose-soft); }
+
+/* ------------------------------------------------------------------ forms */
+
+.field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
+.field label { font-size: 0.79rem; font-weight: 650; color: var(--ink-soft); letter-spacing: 0.01em; }
+.field .help { font-size: 0.76rem; color: var(--ink-faint); }
+input[type='text'], input[type='number'], input[type='url'], input[type='password'], select, textarea {
+  width: 100%;
+  padding: 9px 12px;
+  border: 1px solid var(--line-strong);
+  border-radius: var(--radius-sm);
+  background: var(--paper);
+  font-size: 0.9rem;
+}
+textarea { resize: vertical; min-height: 120px; font-family: var(--font-mono); font-size: 0.83rem; line-height: 1.6; }
+textarea.prose { font-family: var(--font-ui); font-size: 0.9rem; }
+select { cursor: pointer; }
+input:focus, select:focus, textarea:focus { border-color: var(--terracotta); outline: none; box-shadow: 0 0 0 3px rgba(194, 100, 60, 0.14); }
+.check { display: flex; align-items: center; gap: 8px; font-size: 0.87rem; cursor: pointer; }
+.check input { width: 17px; height: 17px; accent-color: var(--terracotta); cursor: pointer; }
+
+.segmented { display: inline-flex; background: rgba(232, 223, 205, 0.55); border-radius: 999px; padding: 3px; gap: 2px; flex-wrap: wrap; }
+.segmented button {
+  border: none; background: transparent; padding: 6px 14px; border-radius: 999px;
+  font-size: 0.84rem; font-weight: 600; color: var(--ink-soft); cursor: pointer;
+}
+.segmented button.active { background: var(--paper); color: var(--ink); box-shadow: var(--shadow-sm); }
+
+/* ------------------------------------------------------------------ misc */
+
+.muted { color: var(--ink-soft); }
+.faint { color: var(--ink-faint); }
+.small { font-size: 0.82rem; }
+.tiny { font-size: 0.74rem; }
+.mono { font-family: var(--font-mono); }
+.center { text-align: center; }
+.divider { height: 1px; background: var(--line); margin: 16px 0; border: 0; }
+
+.empty {
+  text-align: center; padding: 44px 22px; color: var(--ink-soft);
+  border: 1px dashed var(--line-strong); border-radius: var(--radius); background: rgba(255, 253, 248, 0.6);
+}
+.empty .big { font-size: 2rem; margin-bottom: 8px; }
+
+.stat { display: flex; flex-direction: column; gap: 2px; }
+.stat .value { font-family: var(--font); font-size: 1.65rem; font-weight: 600; line-height: 1.1; }
+.stat .label { font-size: 0.73rem; text-transform: uppercase; letter-spacing: 0.09em; color: var(--ink-faint); font-weight: 650; }
+
+.callout {
+  border-left: 3px solid var(--mustard);
+  background: var(--mustard-soft);
+  padding: 11px 15px;
+  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
+  font-size: 0.85rem;
+  color: #6f5212;
+}
+.callout.info { border-color: var(--sky); background: var(--sky-soft); color: #26526a; }
+.callout.good { border-color: var(--sage); background: var(--sage-soft); color: #38512f; }
+.callout.bad { border-color: var(--rose); background: var(--rose-soft); color: #7d2d3a; }
+
+/* ------------------------------------------------------------------ steps */
+
+.steps { display: flex; flex-direction: column; gap: 8px; }
+.step {
+  display: grid;
+  grid-template-columns: 34px minmax(0, 1fr) auto;
+  gap: 12px;
+  align-items: start;
+  padding: 11px 14px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-sm);
+  background: var(--paper);
+}
+.step.done { background: var(--sage-soft); border-color: #cfdcc9; }
+.step.done .instruction { opacity: 0.62; text-decoration: line-through; }
+.step.problem { border-color: #e6b8bf; background: #fdf3f4; }
+.step .tick {
+  width: 26px; height: 26px; border-radius: 8px; border: 1.5px solid var(--line-strong);
+  background: var(--paper); display: grid; place-items: center; cursor: pointer;
+  font-size: 0.8rem; color: transparent; font-weight: 700; margin-top: 2px;
+}
+.step.done .tick { background: var(--sage); border-color: var(--sage); color: #fff; }
+.step .label { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--terracotta); }
+.step .instruction { font-size: 0.92rem; line-height: 1.5; word-break: break-word; }
+.step .counts { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; font-variant-numeric: tabular-nums; }
+.step .counts .primary-count { font-family: var(--font); font-size: 1.05rem; font-weight: 600; }
+.step .counts .declared { font-size: 0.72rem; color: var(--ink-faint); }
+.step .counts .mismatch { color: var(--rose); font-weight: 700; }
+.step.note .instruction { font-style: italic; color: var(--ink-soft); }
+
+/* ------------------------------------------------------------------ diagnostics */
+
+.diag { border-radius: var(--radius-sm); padding: 11px 14px; font-size: 0.85rem; border: 1px solid transparent; }
+.diag + .diag { margin-top: 8px; }
+.diag.error { background: var(--rose-soft); border-color: #eabfc6; color: #7d2d3a; }
+.diag.warning { background: var(--mustard-soft); border-color: #eddcaf; color: #6f5212; }
+.diag.info { background: var(--sky-soft); border-color: #c6dde6; color: #26526a; }
+.diag .diag-head { display: flex; gap: 8px; align-items: center; font-weight: 650; margin-bottom: 3px; }
+.diag .diag-code { font-family: var(--font-mono); font-size: 0.68rem; opacity: 0.7; margin-left: auto; }
+.diag .hint { font-size: 0.79rem; opacity: 0.9; margin-top: 4px; }
+.diag .fix { margin-top: 6px; font-size: 0.79rem; font-weight: 600; }
+
+/* ------------------------------------------------------------------ counter */
+
+.counter-display {
+  display: grid; place-items: center; padding: 26px 16px;
+  background: linear-gradient(160deg, #2c2519, #4a3d2c);
+  border-radius: var(--radius-lg); color: var(--cream);
+}
+.counter-display .value { font-family: var(--font); font-size: clamp(3rem, 12vw, 4.6rem); line-height: 1; font-weight: 600; font-variant-numeric: tabular-nums; }
+.counter-display .caption { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.72; margin-top: 6px; }
+.counter-pad { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
+.counter-pad .btn { padding: 16px; font-size: 1.05rem; border-radius: var(--radius); }
+
+/* ------------------------------------------------------------------ canvas */
+
+.canvas-grid { display: inline-grid; gap: 1px; background: var(--line-strong); padding: 1px; border-radius: 8px; }
+.canvas-cell {
+  width: var(--cell, 30px); height: var(--cell, 30px);
+  background: var(--paper); display: grid; place-items: center;
+  cursor: pointer; position: relative; font-size: calc(var(--cell, 30px) * 0.55);
+  user-select: none;
+}
+.canvas-cell:hover { outline: 2px solid var(--terracotta); outline-offset: -2px; z-index: 2; }
+.canvas-cell svg { width: 78%; height: 78%; }
+.palette { display: flex; flex-wrap: wrap; gap: 7px; }
+.palette button {
+  width: 42px; height: 42px; border-radius: 10px; border: 1.5px solid var(--line-strong);
+  background: var(--paper); cursor: pointer; display: grid; place-items: center; padding: 4px;
+}
+.palette button.active { border-color: var(--terracotta); box-shadow: 0 0 0 2px rgba(194, 100, 60, 0.25); }
+
+/* ------------------------------------------------------------------ photo */
+
+.dropzone {
+  border: 2px dashed var(--line-strong);
+  border-radius: var(--radius);
+  padding: 30px 20px;
+  text-align: center;
+  background: rgba(255, 253, 248, 0.7);
+  cursor: pointer;
+  transition: border-color 0.15s ease, background 0.15s ease;
+}
+.dropzone:hover, .dropzone.drag { border-color: var(--terracotta); background: var(--terracotta-soft); }
+.photo-frame { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #000; }
+.photo-frame img { width: 100%; max-height: 340px; object-fit: contain; }
+
+.guess { display: flex; gap: 12px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--line); }
+.guess:last-child { border-bottom: 0; }
+.guess .rank { width: 26px; height: 26px; border-radius: 50%; background: var(--line); display: grid; place-items: center; font-size: 0.78rem; font-weight: 700; color: var(--ink-soft); flex: none; }
+.guess.top .rank { background: var(--terracotta); color: #fff; }
+.guess .name { font-weight: 650; font-size: 0.94rem; }
+.guess .why { font-size: 0.79rem; color: var(--ink-soft); }
+.meter { height: 6px; border-radius: 999px; background: var(--line); overflow: hidden; }
+.meter > i { display: block; height: 100%; background: linear-gradient(90deg, var(--terracotta), var(--mustard)); border-radius: 999px; }
+
+/* ------------------------------------------------------------------ modules */
+
+.course-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
+.course-card .band { padding: 18px 20px; color: #fff; }
+.course-card .band h3 { margin: 0 0 2px; color: #fff; }
+.course-card .band p { margin: 0; font-size: 0.83rem; opacity: 0.9; }
+.lesson {
+  display: flex; gap: 12px; align-items: flex-start; padding: 13px 18px;
+  border-top: 1px solid var(--line); cursor: pointer;
+}
+.lesson:hover { background: #faf6ec; }
+.lesson .bullet { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--line-strong); display: grid; place-items: center; font-size: 0.7rem; flex: none; margin-top: 2px; color: transparent; }
+.lesson.done .bullet { background: var(--sage); border-color: var(--sage); color: #fff; }
+.lesson h4 { margin: 0 0 2px; font-size: 0.94rem; }
+.lesson p { margin: 0; font-size: 0.82rem; color: var(--ink-soft); }
+.lesson .tip { margin-top: 6px; font-size: 0.78rem; color: #6f5212; background: var(--mustard-soft); padding: 6px 9px; border-radius: 8px; }
+.progress-track { height: 7px; background: rgba(255, 255, 255, 0.28); border-radius: 999px; overflow: hidden; margin-top: 10px; }
+.progress-track > i { display: block; height: 100%; background: #fff; border-radius: 999px; }
+
+.step-diagram { display: flex; gap: 4px; align-items: flex-end; flex-wrap: wrap; padding: 8px 0; }
+.step-diagram figure { margin: 0; text-align: center; }
+.step-diagram figcaption { font-size: 0.62rem; color: var(--ink-faint); margin-top: 2px; }
+
+/* ------------------------------------------------------------------ misc */
+
+.toast {
+  position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%);
+  background: var(--ink); color: var(--cream); padding: 11px 20px; border-radius: 999px;
+  font-size: 0.86rem; font-weight: 550; box-shadow: var(--shadow-lg); z-index: 100;
+  animation: toast-in 0.22s ease;
+}
+@keyframes toast-in { from { opacity: 0; transform: translate(-50%, 10px); } to { opacity: 1; transform: translate(-50%, 0); } }
+
+.modal-backdrop { position: fixed; inset: 0; background: rgba(44, 37, 25, 0.42); display: grid; place-items: center; padding: 20px; z-index: 90; }
+.modal { background: var(--paper); border-radius: var(--radius-lg); padding: 24px; max-width: 520px; width: 100%; box-shadow: var(--shadow-lg); max-height: 88vh; overflow: auto; }
+
+.hero {
+  position: relative;
+  background: linear-gradient(150deg, #2c2519, #52412c 62%, #6b5232);
+  border-radius: var(--radius-lg);
+  padding: clamp(26px, 5vw, 52px);
+  color: var(--cream);
+  overflow: hidden;
+}
+.hero h1 { color: var(--cream); max-width: 20ch; }
+.hero p { color: rgba(251, 246, 236, 0.82); max-width: 52ch; }
+.hero .yarn-art { position: absolute; right: -30px; top: -20px; opacity: 0.16; pointer-events: none; }
+.hero .row { margin-top: 22px; }
+.hero .btn.primary { background: var(--mustard); border-color: var(--mustard); color: #2c2519; }
+.hero .btn.primary:hover { background: #e8b04a; }
+.hero .btn:not(.primary) { background: transparent; color: var(--cream); border-color: rgba(251, 246, 236, 0.35); }
+.hero .btn:not(.primary):hover { background: rgba(251, 246, 236, 0.12); }
+
+.section { margin-top: 36px; }
+.section-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 14px; }
+.section-head h2 { margin: 0; }
+.section-head a { font-size: 0.85rem; margin-left: auto; }
+
+.table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
+.table th { text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-faint); padding: 7px 8px; border-bottom: 1px solid var(--line); }
+.table td { padding: 8px; border-bottom: 1px solid var(--line); }
+.table tr:last-child td { border-bottom: 0; }
+.table td.num { text-align: right; font-variant-numeric: tabular-nums; }
+
+@media (prefers-reduced-motion: reduce) {
+  * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
+}
+@media (max-width: 720px) {
+  .main { padding: 18px 14px 70px; }
+  .topbar-inner { padding: 10px 14px; gap: 10px; flex-wrap: wrap; }
+  .nav { width: 100%; overflow-x: auto; padding-bottom: 2px; margin-left: 0; }
+  .nav a { padding: 6px 10px; font-size: 0.82rem; }
+  .step { grid-template-columns: 30px minmax(0, 1fr); }
+  .step .counts { grid-column: 2; flex-direction: row; align-items: center; gap: 8px; }
+}
