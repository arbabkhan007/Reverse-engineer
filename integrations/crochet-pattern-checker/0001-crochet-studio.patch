+import { useMemo, useState } from 'react';
+import { CANVAS_SYMBOLS, type CanvasDesign, type CanvasSymbol } from '../../shared/types.ts';
+import { generateVerifiedFromCanvas } from '../../domain/patternGenerator.ts';
