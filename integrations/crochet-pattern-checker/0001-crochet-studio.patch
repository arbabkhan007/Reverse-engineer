+import { describe, it, expect } from 'vitest';
+import {
+  estimateYarn,
+  generateVerifiedFromCanvas,
+  generateVerifiedFromShape,
+} from '../domain/patternGenerator.ts';
+import { buildCatalog, patternText, weeklyPicks } from '../domain/catalog.ts';
+import { parsePattern } from '../domain/patternParser.ts';
+import { summarise } from '../domain/checkerSummary.ts';
+import type { CanvasDesign, CanvasSymbol } from '../shared/types.ts';
+
+const SHAPES = [
+  'flat-circle',
+  'granny-square',
+  'amigurumi-sphere',
+  'flat-panel',
+  'hat-in-the-round',
+  'chevron',
+  'basket',
+  'coaster-set',
+  'tote',
+  'ear-warmer',
+  'bookmark',
+] as const;
+
+describe('shape generator', () => {
+  it('produces instructions whose stated counts agree with the checker', () => {
+    for (const kind of SHAPES) {
+      const { parsed } = generateVerifiedFromShape(
+        { kind, stitch: 'sc', rows: 8, width: 16, start: 6 },
+        { title: `Test ${kind}` },
+      );
+      expect(parsed.steps.length, kind).toBeGreaterThan(0);
+      const errors = parsed.diagnostics.filter((d) => d.severity === 'error');
+      expect(errors.map((e) => `${kind}: ${e.message}`)).toEqual([]);
+    }
+  });
+
+  it('keeps chevron rows width-neutral', () => {
+    const { parsed } = generateVerifiedFromShape(
+      { kind: 'chevron', stitch: 'dc', rows: 4, start: 5 },
+      { title: 'Chevron' },
+    );
+    const counts = parsed.steps
+      .filter((step) => step.kind === 'row' && step.computedCount !== undefined)
+      .map((step) => step.computedCount);
+    expect(new Set(counts).size).toBe(1);
+    expect(counts[0]).toBe(45);
+  });
+
+  it('regression: nested repeats do not grow an unparsed array into itself', () => {
+    // This instruction previously overflowed the stack through a shared array.
+    const { parsed } = generateVerifiedFromShape(
+      { kind: 'chevron', stitch: 'dc', rows: 3, start: 5 },
+      { title: 'Nested repeat' },
+    );
+    expect(parsed.steps.some((step) => step.instruction.includes('inc) x 5'))).toBe(true);
+  });
+});
+
+describe('canvas generator', () => {
+  const design: CanvasDesign = {
+    id: 'test',
+    name: 'Test canvas',
+    width: 4,
+    height: 3,
+    cells: [
+      'sc', 'sc', 'dc', 'dc',
+      'sc', 'inc', 'dc', 'blank',
+      'dec', 'sc', 'ch', 'blank',
+    ] as CanvasSymbol[],
+    colors: Array<string>(12).fill('#fff'),
+    palette: ['#fff'],
+    baseStitch: 'sc',
+    createdAt: 0,
+    updatedAt: 0,
+  };
+
+  it('turns a grid into verifiable rows', () => {
+    const { parsed } = generateVerifiedFromCanvas(design);
+    const rows = parsed.steps.filter((step) => step.kind === 'row');
+    expect(rows).toHaveLength(3);
+    // Row 1: sc, sc, dc, dc -> 4 stitches.
+    expect(rows[0]!.computedCount).toBe(4);
+    // Row 2: sc + inc(2) + dc = 4 stitches, and the blank cell is skipped.
+    expect(rows[1]!.computedCount).toBe(4);
+    expect(parsed.diagnostics.filter((d) => d.severity === 'error')).toEqual([]);
+  });
+
+  it('skips entirely empty rows', () => {
+    const empty: CanvasDesign = {
+      ...design,
+      cells: Array<CanvasSymbol>(12).fill('blank'),
+    };
+    expect(generateVerifiedFromCanvas(empty).generated.rows).toHaveLength(0);
+  });
+});
+
+describe('yarn estimate', () => {
+  it('scales with stitch count and always reports a caveat', () => {
+    const small = estimateYarn([{ instruction: 'sc in each st across' }], { stitches: 100 });
+    const large = estimateYarn([{ instruction: 'sc in each st across' }], { stitches: 1000 });
+    expect(large.metres).toBeGreaterThan(small.metres);
+    expect(small.skeins).toBeGreaterThanOrEqual(1);
+    expect(small.note.toLowerCase()).toContain('estimate');
+  });
+});
+
+describe('catalog', () => {
+  it('ships more than 500 patterns across every category and level', () => {
+    const catalog = buildCatalog();
+    expect(catalog.length).toBeGreaterThan(500);
+    expect(new Set(catalog.map((p) => p.category)).size).toBe(10);
+    expect(new Set(catalog.map((p) => p.level)).size).toBe(4);
+    expect(new Set(catalog.map((p) => p.id)).size).toBe(catalog.length);
+  });
+
+  it('every pattern has matching counts', () => {
+    const catalog = buildCatalog();
+    const failures: string[] = [];
+    for (const pattern of catalog.slice(0, 80)) {
+      const parsed = parsePattern(patternText(pattern), { title: pattern.title });
+      const summary = summarise(parsed);
+      if (summary.errors > 0) failures.push(pattern.id);
+    }
+    expect(failures).toEqual([]);
+  });
+
+  it('rotates weekly picks deterministically', () => {
+    const a = weeklyPicks(new Date('2026-01-05')).map((p) => p.id);
+    const b = weeklyPicks(new Date('2026-01-06')).map((p) => p.id);
+    expect(a).toEqual(b);
+    expect(a.length).toBeGreaterThan(0);
+  });
+});
diff --git a/web/studio/src/tests/patternChecker.test.ts b/web/studio/src/tests/patternChecker.test.ts
new file mode 100644
index 0000000..1965e6d
--- /dev/null
+++ b/web/studio/src/tests/patternChecker.test.ts
@@ -0,0 +1,97 @@
+import { describe, it, expect } from 'vitest';
+import { evaluateInstruction, extractDeclaredCount } from '../domain/patternChecker.ts';
+import { parsePattern } from '../domain/patternParser.ts';
+import { AMIGURUMI_BALL, BROKEN_COUNTS, FLAT_WASHCLOTH, MESSY_PDF_TEXT, UK_TERMS } from './fixtures.ts';
+
+describe('evaluateInstruction', () => {
+  it('counts a foundation chain-only step', () => {
+    expect(evaluateInstruction('ch 31').count).toBe(31);
+  });
+
+  it('ignores the turning chain in a sc row', () => {
+    expect(evaluateInstruction('ch 1, turn, sc in each st across').count).toBe(1);
+  });
+
+  it('multiplies bracket repeats', () => {
+    expect(evaluateInstruction('(sc, inc) x 6').count).toBe(18);
+    expect(evaluateInstruction('(2 sc, inc) x 6').count).toBe(24);
+    expect(evaluateInstruction('(3 sc, dec) x 6').count).toBe(24);
+  });
+
+  it('handles repeat wording', () => {
+    // dc (1) + "2 dc in next st" (2) = 3 stitches per group, x6 = 18.
+    expect(evaluateInstruction('(dc, 2 dc in next st) rep 6 times').count).toBe(18);
+    expect(evaluateInstruction('*sc, inc* rep 6 times').count).toBe(18);
+  });
+
+  it('counts increases and decreases', () => {
+    expect(evaluateInstruction('inc in each st around').count).toBe(2);
+    expect(evaluateInstruction('dec x 6').count).toBe(6);
+    expect(evaluateInstruction('2 sc in next st').count).toBe(2);
+  });
+
+  it('handles decreases written together', () => {
+    expect(evaluateInstruction('sc2tog 6 times').count).toBeGreaterThan(0);
+    expect(evaluateInstruction('(2 sc, sc2tog) x 3').count).toBe(9);
+  });
+
+  it('parses declared counts from several layouts', () => {
+    expect(extractDeclaredCount('sc in each st around (30)')).toBe(30);
+    expect(extractDeclaredCount('sc in each st around - 30 sts')).toBe(30);
+    expect(extractDeclaredCount('sc in each st around [30]')).toBe(30);
+    expect(extractDeclaredCount('sc in each st around, 30 stitches total')).toBe(30);
+    expect(extractDeclaredCount('inc in each st')).toBeUndefined();
+  });
+});
+
+describe('parsePattern', () => {
+  it('parses an amigurumi pattern with matching counts', () => {
+    const pattern = parsePattern(AMIGURUMI_BALL);
+    expect(pattern.title).toBe('Amigurumi Buddy Ball');
+    expect(pattern.designer).toBe('YarnCraft Studio');
+    expect(pattern.craft).toBe('crochet');
+    expect(pattern.supplies.hook).toBe('3.5 mm');
+    const rounds = pattern.steps.filter((s) => s.kind === 'round');
+    expect(rounds).toHaveLength(10);
+    expect(rounds[2]!.declaredCount).toBe(18);
+    expect(rounds[2]!.computedCount).toBe(18);
+    expect(pattern.diagnostics.some((d) => d.code === 'count-mismatch')).toBe(false);
+    expect(pattern.diagnostics.some((d) => d.code === 'math-ok')).toBe(true);
+  });
+
+  it('flags a wrong stitch count and suggests a fix', () => {
+    const pattern = parsePattern(BROKEN_COUNTS);
+    const mismatch = pattern.diagnostics.find((d) => d.code === 'count-mismatch');
+    expect(mismatch).toBeDefined();
+    expect(mismatch!.message).toContain('Row 3');
+    expect(mismatch!.severity).toBe('error');
+  });
+
+  it('handles flat rows with turning chains', () => {
+    const pattern = parsePattern(FLAT_WASHCLOTH);
+    const rows = pattern.steps.filter((s) => s.kind === 'row');
+    expect(rows[0]!.computedCount).toBe(30);
+    expect(rows[1]!.computedCount).toBe(30);
+  });
+
+  it('recognises rounds and UK repeat wording', () => {
+    const pattern = parsePattern(UK_TERMS);
+    expect(pattern.steps.every((s) => s.kind === 'round')).toBe(true);
+    const last = pattern.steps.at(-1)!;
+    expect(last.computedCount).toBe(18);
+  });
+
+  it('strips PDF page furniture and copyright lines', () => {
+    const pattern = parsePattern(MESSY_PDF_TEXT);
+    expect(pattern.title).toBe('Cozy Ear Warmer');
+    expect(pattern.unparsedLines.join(' ')).not.toContain('Page 1');
+    const rows = pattern.steps.filter((s) => s.kind === 'row');
+    expect(rows.length).toBeGreaterThanOrEqual(3);
+    expect(pattern.diagnostics.some((d) => d.code === 'count-mismatch')).toBe(false);
+  });
+
+  it('reports unbalanced brackets instead of guessing', () => {
+    const pattern = parsePattern('Test\nRow 1: (sc, inc x 6 (18)');
+    expect(pattern.diagnostics.some((d) => d.code === 'unbalanced-brackets')).toBe(true);
+  });
+});
