+              {pyBusy ? 'Running the Python engine…' : 'Verify with the Python engine'}
+            </button>
+            {pyError && <div className="callout bad" style={{ marginTop: 12 }}>{pyError}</div>}
+            {pyResult && (
+              <div style={{ marginTop: 12 }}>
