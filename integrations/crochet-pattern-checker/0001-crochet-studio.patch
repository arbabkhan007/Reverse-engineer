+  const catalog = buildCatalog();
+  const picks = weeklyPicks();
+  const tenMinute = catalog.filter((p) => p.minutes <= 15).slice(0, 4);
+  const activeProjects = state.projects.filter((p) => p.status === 'wip').slice(0, 3);
+  const totalRows = Object.values(state.activity).reduce((sum, n) => sum + n, 0);
+
+  return (
+    <div className="stack" style={{ gap: 0 }}>
+      <section className="hero">
+        <YarnBall size={280} className="yarn-art" />
+        <div className="eyebrow" style={{ color: 'var(--mustard)', letterSpacing: '0.16em', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 700 }}>
+          Crochet & knitting companion
+        </div>
+        <h1>Learn it, check it, make it.</h1>
+        <p>
+          {catalog.length}+ patterns with instructions you can trust, a row counter that remembers where
+          you stopped, a checker that finds the counting mistakes before you do, and five courses that
+          take you from your first chain to a finished object.
+        </p>
+        <div className="row">
+          <button className="btn primary lg" onClick={() => navigate('/library')}>
+            Browse patterns
+          </button>
+          <button className="btn lg" onClick={() => navigate('/courses')}>
+            Start learning
+          </button>
+        </div>
+        <div className="row" style={{ marginTop: 26, gap: 26 }}>
+          <div className="stat">
+            <span className="value" style={{ color: 'var(--cream)' }}>{catalog.length}</span>
+            <span className="label" style={{ color: 'rgba(251,246,236,0.6)' }}>patterns</span>
+          </div>
+          <div className="stat">
+            <span className="value" style={{ color: 'var(--cream)' }}>{COURSES.length}</span>
+            <span className="label" style={{ color: 'rgba(251,246,236,0.6)' }}>courses</span>
+          </div>
+          <div className="stat">
+            <span className="value" style={{ color: 'var(--cream)' }}>{state.projects.length}</span>
+            <span className="label" style={{ color: 'rgba(251,246,236,0.6)' }}>your projects</span>
+          </div>
+        </div>
+      </section>
+
+      {activeProjects.length > 0 && (
+        <section className="section">
+          <div className="section-head">
+            <h2>Pick up where you left off</h2>
+            <a href="#/projects">All projects →</a>
+          </div>
+          <div className="grid grid-3">
+            {activeProjects.map((project) => {
+              const done = project.counts.completedSteps.length;
+              const total = project.steps.filter((s) => s.kind === 'row' || s.kind === 'round').length;
+              const percent = total > 0 ? Math.round((done / total) * 100) : 0;
+              return (
+                <button
+                  key={project.id}
+                  className="card"
+                  style={{ textAlign: 'left', cursor: 'pointer' }}
+                  onClick={() => navigate(`/projects?project=${project.id}`)}
+                >
+                  <div className="row-tight" style={{ marginBottom: 6 }}>
+                    <Chip tone="sage">{project.craft}</Chip>
+                    <span className="spacer" />
+                    <span className="tiny faint">{percent}%</span>
+                  </div>
+                  <h4 style={{ margin: '0 0 8px', fontFamily: 'var(--font)' }}>{project.title}</h4>
+                  <div className="meter">
+                    <i style={{ width: `${percent}%` }} />
+                  </div>
+                  <div className="tiny faint" style={{ marginTop: 6 }}>
+                    {done} of {total} rows done
+                  </div>
+                </button>
+              );
+            })}
+          </div>
+        </section>
+      )}
+
+      <section className="section">
+        <div className="section-head">
+          <h2>Fresh this week</h2>
+          <a href="#/library">See the library →</a>
+        </div>
+        <div className="grid grid-3">
+          {picks.map((pattern) => (
+            <PatternCard key={pattern.id} pattern={pattern} />
+          ))}
+        </div>
+      </section>
+
+      <section className="section">
+        <div className="section-head">
+          <h2>Ten minutes or less</h2>
+          <span className="chip mustard">{tenMinute.length} quick wins</span>
+        </div>
+        <div className="grid grid-4">
+          {tenMinute.map((pattern) => (
+            <button
+              key={pattern.id}
+              className="card"
+              style={{ textAlign: 'left', cursor: 'pointer' }}
+              onClick={() => navigate(`/pattern/${pattern.id}`)}
+            >
+              <div className="tiny faint" style={{ letterSpacing: '0.08em', textTransform: 'uppercase' }}>
+                {formatMinutes(pattern.minutes)}
+              </div>
+              <h4 style={{ margin: '4px 0 2px', fontFamily: 'var(--font)' }}>{pattern.title}</h4>
+              <div className="tiny faint">{pattern.category}</div>
+            </button>
+          ))}
+        </div>
+      </section>
+
+      <section className="section">
+        <div className="section-head">
+          <h2>Every tool in one place</h2>
+        </div>
+        <div className="grid grid-3">
+          {TOOLS.map((tool) => (
+            <button
+              key={tool.href}
+              className="card"
+              style={{ textAlign: 'left', cursor: 'pointer' }}
+              onClick={() => navigate(tool.href)}
+            >
+              <div style={{ fontSize: '1.3rem', color: 'var(--terracotta)', marginBottom: 4 }}>{tool.icon}</div>
+              <h4 style={{ margin: '0 0 4px', fontFamily: 'var(--font)' }}>{tool.title}</h4>
+              <p className="small muted" style={{ margin: 0 }}>{tool.text}</p>
+            </button>
+          ))}
+        </div>
+      </section>
+
+      <section className="section">
+        <div className="section-head">
+          <h2>Seasonal collections</h2>
+        </div>
+        <div className="grid grid-4">
+          {COLLECTIONS.map((collection) => {
+            const items = catalog.filter((p) => p.collection === collection.key);
+            return (
+              <button
+                key={collection.key}
+                className="card"
+                style={{ textAlign: 'left', cursor: 'pointer' }}
+                onClick={() => navigate(`/library?collection=${collection.key}`)}
+              >
+                <div style={{ fontSize: '1.6rem' }}>{collection.emoji}</div>
+                <h4 style={{ margin: '6px 0 2px', fontFamily: 'var(--font)' }}>{collection.label}</h4>
+                <div className="tiny faint">{items.length} patterns</div>
+              </button>
+            );
+          })}
+        </div>
+      </section>
+
+      {totalRows > 0 && (
+        <section className="section">
+          <div className="card">
+            <div className="row">
+              <div className="stat">
+                <span className="value">{totalRows}</span>
+                <span className="label">rows completed</span>
+              </div>
+              <div className="stat">
+                <span className="value">{Object.keys(state.activity).length}</span>
+                <span className="label">active days</span>
+              </div>
+              <span className="spacer" />
+              <span className="small muted">Every tick is saved to this device.</span>
+            </div>
+          </div>
+        </section>
+      )}
+    </div>
+  );
+}
diff --git a/web/studio/src/client/pages/Library.tsx b/web/studio/src/client/pages/Library.tsx
new file mode 100644
index 0000000..b862734
--- /dev/null
+++ b/web/studio/src/client/pages/Library.tsx
@@ -0,0 +1,162 @@
+import { useMemo, useState } from 'react';
+import { buildCatalog, COLLECTIONS } from '../../domain/catalog.ts';
+import { CATEGORIES, SKILL_LEVELS, type Category, type SkillLevel } from '../../shared/types.ts';
+import { useStore } from '../store.tsx';
+import { useRoute } from '../lib/router.ts';
+import { PatternCard } from '../components/PatternBits.tsx';
+import { Chip } from '../components/ui.tsx';
+
+type SortKey = 'popular' | 'quick' | 'az' | 'level';
+
+const LEVEL_ORDER: Record<SkillLevel, number> = { beginner: 0, easy: 1, intermediate: 2, advanced: 3 };
+
+export function LibraryPage() {
+  const { state } = useStore();
+  const { query } = useRoute();
+  const catalog = useMemo(() => buildCatalog(), []);
+
+  const [search, setSearch] = useState('');
+  const [category, setCategory] = useState<Category | 'all'>((query.get('category') as Category) ?? 'all');
+  const [level, setLevel] = useState<SkillLevel | 'all'>('all');
+  const [collection, setCollection] = useState<string>(query.get('collection') ?? 'all');
+  const [sort, setSort] = useState<SortKey>('popular');
+  const [onlySaved, setOnlySaved] = useState(false);
+  const [limit, setLimit] = useState(48);
+
+  const filtered = useMemo(() => {
+    const term = search.trim().toLowerCase();
+    const items = catalog.filter((pattern) => {
+      if (category !== 'all' && pattern.category !== category) return false;
+      if (level !== 'all' && pattern.level !== level) return false;
+      if (collection !== 'all' && pattern.collection !== collection) return false;
+      if (onlySaved && !state.savedPatterns.includes(pattern.id)) return false;
+      if (!term) return true;
+      return (
+        pattern.title.toLowerCase().includes(term) ||
+        pattern.blurb.toLowerCase().includes(term) ||
+        pattern.tags.some((tag) => tag.includes(term)) ||
+        pattern.category.toLowerCase().includes(term)
+      );
+    });
+
+    const sorted = [...items];
+    if (sort === 'quick') sorted.sort((a, b) => a.minutes - b.minutes);
+    else if (sort === 'az') sorted.sort((a, b) => a.title.localeCompare(b.title));
+    else if (sort === 'level') sorted.sort((a, b) => LEVEL_ORDER[a.level] - LEVEL_ORDER[b.level]);
+    else sorted.sort((a, b) => Number(b.tenMinute ?? false) - Number(a.tenMinute ?? false) || a.minutes - b.minutes);
+    return sorted;
+  }, [catalog, search, category, level, collection, sort, onlySaved, state.savedPatterns]);
+
+  const reset = () => {
+    setSearch('');
+    setCategory('all');
+    setLevel('all');
+    setCollection('all');
+    setOnlySaved(false);
+  };
+
+  return (
+    <div>
+      <div className="page-head">
+        <div className="eyebrow">Pattern library</div>
+        <h1>Find your next project</h1>
+        <p className="lead">
+          {catalog.length} patterns across {CATEGORIES.length} categories, from ten-minute wins to
+          advanced lace. Every generated pattern comes with written instructions that the checker has
+          verified against its own stitch maths.
+        </p>
+      </div>
+
+      <div className="card" style={{ marginBottom: 20 }}>
+        <div className="row" style={{ gap: 10 }}>
+          <input
+            type="text"
+            placeholder="Search by name, technique or category…"
+            value={search}
+            onChange={(event) => setSearch(event.target.value)}
+            style={{ flex: 1, minWidth: 220 }}
+            aria-label="Search patterns"
+          />
+          <select value={category} onChange={(event) => setCategory(event.target.value as Category | 'all')} aria-label="Category" style={{ width: 'auto' }}>
+            <option value="all">All categories</option>
+            {CATEGORIES.map((item) => (
+              <option key={item} value={item}>{item}</option>
+            ))}
+          </select>
+          <select value={level} onChange={(event) => setLevel(event.target.value as SkillLevel | 'all')} aria-label="Skill level" style={{ width: 'auto' }}>
+            <option value="all">Any level</option>
+            {SKILL_LEVELS.map((item) => (
+              <option key={item} value={item}>{item}</option>
+            ))}
+          </select>
+          <select value={sort} onChange={(event) => setSort(event.target.value as SortKey)} aria-label="Sort" style={{ width: 'auto' }}>
+            <option value="popular">Quick wins first</option>
+            <option value="quick">Shortest first</option>
+            <option value="az">A to Z</option>
+            <option value="level">Easiest first</option>
+          </select>
+        </div>
+
+        <div className="row" style={{ marginTop: 12, gap: 6 }}>
+          <Chip
+            tone={collection === 'all' ? 'terracotta' : 'default'}
+            outline={collection !== 'all'}
+          >
+            <button
+              onClick={() => setCollection('all')}
+              style={{ background: 'none', border: 0, padding: 0, cursor: 'pointer', color: 'inherit', font: 'inherit' }}
+            >
+              All year
+            </button>
+          </Chip>
+          {COLLECTIONS.map((item) => (
+            <Chip key={item.key} tone={collection === item.key ? 'terracotta' : 'default'} outline={collection !== item.key}>
+              <button
+                onClick={() => setCollection(item.key)}
+                style={{ background: 'none', border: 0, padding: 0, cursor: 'pointer', color: 'inherit', font: 'inherit' }}
+              >
+                {item.emoji} {item.label}
+              </button>
+            </Chip>
+          ))}
+          <span className="spacer" />
+          <label className="check small">
+            <input type="checkbox" checked={onlySaved} onChange={(event) => setOnlySaved(event.target.checked)} />
+            Saved only ({state.savedPatterns.length})
+          </label>
+          <button className="btn ghost sm" onClick={reset}>Reset</button>
+        </div>
+      </div>
+
+      <div className="row" style={{ marginBottom: 14 }}>
+        <span className="small muted">
+          {filtered.length} {filtered.length === 1 ? 'pattern' : 'patterns'}
+        </span>
+      </div>
+
+      {filtered.length === 0 ? (
+        <div className="empty">
+          <div className="big">🧶</div>
+          <h3>Nothing matches those filters</h3>
+          <p className="small">Try a broader search, or reset the filters.</p>
+          <button className="btn" onClick={reset}>Reset filters</button>
+        </div>
+      ) : (
+        <>
+          <div className="grid grid-3">
+            {filtered.slice(0, limit).map((pattern) => (
+              <PatternCard key={pattern.id} pattern={pattern} />
+            ))}
+          </div>
+          {filtered.length > limit && (
+            <div className="center" style={{ marginTop: 24 }}>
+              <button className="btn lg" onClick={() => setLimit((value) => value + 48)}>
+                Show more ({filtered.length - limit} remaining)
+              </button>
+            </div>
+          )}
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/web/studio/src/client/pages/PatternView.tsx b/web/studio/src/client/pages/PatternView.tsx
new file mode 100644
index 0000000..234ccbd
--- /dev/null
+++ b/web/studio/src/client/pages/PatternView.tsx
@@ -0,0 +1,227 @@
+import { useMemo, useState } from 'react';
+import { findPattern, patternText } from '../../domain/catalog.ts';
+import { parsePattern, serialisePattern } from '../../domain/patternParser.ts';
+import { estimateYarn } from '../../domain/patternGenerator.ts';
+import { summarise, formatMinutes } from '../../domain/checkerSummary.ts';
+import { findStitch } from '../../domain/stitches.ts';
+import { useStore } from '../store.tsx';
+import { navigate, useRoute } from '../lib/router.ts';
+import { DiagnosticList, StepRow } from '../components/PatternBits.tsx';
+import { Chip, LevelChip, useToast } from '../components/ui.tsx';
+import { StitchSymbol } from '../components/StitchSymbol.tsx';
+
+export function PatternViewPage() {
+  const { parts } = useRoute();
+  const id = parts[1] ?? '';
+  const { state, toggleSavedPattern, touchRecent, startProject } = useStore();
+  const toast = useToast();
+  const [showAll, setShowAll] = useState(false);
+
+  const custom = state.customPatterns.find((record) => record.id === id);
+  const catalog = custom ? undefined : findPattern(id);
+
+  const parsed = useMemo(() => {
+    if (custom) return custom.parsed;
+    if (!catalog) return null;
+    return parsePattern(patternText(catalog), { title: catalog.title });
+  }, [catalog, custom]);
+
+  // Record the visit once per mount.
+  useMemo(() => {
+    if (parsed && (catalog || custom)) touchRecent(id);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  if (!parsed || (!catalog && !custom)) {
+    return (
+      <div className="empty">
+        <div className="big">🪡</div>
+        <h3>Pattern not found</h3>
+        <p className="small">It may have been removed from your imports.</p>
+        <button className="btn" onClick={() => navigate('/library')}>Back to the library</button>
+      </div>
+    );
+  }
+
+  const summary = summarise(parsed);
+  const yarn = estimateYarn(parsed.steps);
+  const saved = state.savedPatterns.includes(id);
+  const title = catalog?.title ?? custom?.title ?? parsed.title;
+  const minutes = catalog?.minutes;
+  const stepsToShow = showAll ? parsed.steps : parsed.steps.slice(0, 14);
+
+  const begin = () => {
+    const project = startProject({
+      title,
+      patternId: id,
+      craft: parsed.craft,
+      steps: parsed.steps,
+      ...(parsed.supplies.yarn ? { yarn: parsed.supplies.yarn } : {}),
+      ...(parsed.supplies.hook ? { hook: parsed.supplies.hook } : {}),
+    });
+    toast.show('Project started - your counter is ready');
+    navigate(`/projects?project=${project.id}`);
+  };
+
+  const copyText = async () => {
+    try {
+      await navigator.clipboard.writeText(serialisePattern(parsed));
+      toast.show('Clean pattern copied');
+    } catch {
+      toast.show('Clipboard is not available in this browser');
+    }
+  };
+
+  return (
+    <div>
+      <button className="btn ghost sm" onClick={() => navigate(catalog ? '/library' : '/converter')} style={{ marginBottom: 12 }}>
+        ← Back
+      </button>
+
+      <div className="page-head">
+        <div className="row-tight" style={{ marginBottom: 8, flexWrap: 'wrap' }}>
+          {catalog && <LevelChip level={catalog.level} />}
+          {catalog && <Chip outline>{catalog.category}</Chip>}
+          <Chip tone="terracotta">{parsed.craft}</Chip>
+          {minutes !== undefined && <Chip tone="sky">⏱ {formatMinutes(minutes)}</Chip>}
+          {catalog?.tenMinute && <Chip tone="mustard">10 minute make</Chip>}
+        </div>
+        <h1 style={{ marginBottom: 6 }}>{title}</h1>
+        <p className="lead">
+          {catalog?.blurb ?? `${parsed.steps.length} steps imported from ${custom?.source === 'pdf' ? 'a PDF' : custom?.source === 'web' ? 'a web page' : custom?.source === 'canvas' ? 'your canvas design' : 'pasted text'}.`}
+        </p>
+        <div className="row" style={{ marginTop: 14 }}>
+          <button className="btn primary" onClick={begin}>Start project & row counter</button>
+          <button className="btn" onClick={() => toggleSavedPattern(id)}>
+            {saved ? '★ Saved' : '☆ Save'}
+          </button>
+          <button className="btn" onClick={copyText}>Copy clean text</button>
+        </div>
+      </div>
+
+      <div className="split">
+        <div className="stack">
+          <div className="card">
+            <div className="card-title">
+              <h3>Instructions</h3>
+              <span className="meta">{parsed.steps.length} steps</span>
+            </div>
+            <div className="steps">
+              {stepsToShow.map((step) => (
+                <StepRow
+                  key={step.index}
+                  step={step}
+                  problems={parsed.diagnostics.filter((d) => d.stepIndex === step.index && d.severity === 'error')}
+                />
+              ))}
+            </div>
+            {parsed.steps.length > stepsToShow.length && (
+              <div className="center" style={{ marginTop: 14 }}>
+                <button className="btn" onClick={() => setShowAll(true)}>
+                  Show all {parsed.steps.length} steps
+                </button>
+              </div>
+            )}
+          </div>
+
+          {parsed.diagnostics.length > 0 && (
+            <div className="card">
+              <div className="card-title">
+                <h3>Check results</h3>
+                <span className="meta">{summary.verdict}</span>
+              </div>
+              <DiagnosticList diagnostics={parsed.diagnostics} />
+            </div>
+          )}
+
+          {parsed.unparsedLines.length > 0 && (
+            <div className="card">
+              <div className="card-title">
+                <h3>Text that was not part of the instructions</h3>
+              </div>
+              <p className="small muted">
+                These lines were kept for reference but not counted as steps.
+              </p>
+              <ul className="small muted" style={{ margin: 0, paddingLeft: 18 }}>
+                {parsed.unparsedLines.slice(0, 10).map((line, index) => (
+                  <li key={index}>{line}</li>
+                ))}
+              </ul>
+            </div>
+          )}
+        </div>
+
+        <div className="stack">
+          <div className="card">
+            <div className="card-title"><h3>Pattern health</h3></div>
+            <div className="row" style={{ alignItems: 'flex-end', gap: 14 }}>
+              <div className="stat">
+                <span className="value" style={{ color: summary.errors > 0 ? 'var(--rose)' : 'var(--sage)' }}>
+                  {summary.score}
+                </span>
+                <span className="label">score / 100</span>
+              </div>
+              <div className="stat">
+                <span className="value">{summary.checkedSteps}/{summary.totalSteps}</span>
+                <span className="label">counts verified</span>
+              </div>
+            </div>
+            <div className="meter" style={{ marginTop: 12 }}>
+              <i style={{ width: `${summary.score}%` }} />
+            </div>
+            <p className="small muted" style={{ marginTop: 10, marginBottom: 0 }}>{summary.verdict}</p>
+          </div>
+
+          <div className="card">
+            <div className="card-title"><h3>Supplies</h3></div>
+            <table className="table">
+              <tbody>
+                {Object.entries(parsed.supplies)
+                  .filter(([, value]) => Boolean(value))
+                  .map(([key, value]) => (
+                    <tr key={key}>
+                      <td className="faint" style={{ textTransform: 'capitalize' }}>{key}</td>
+                      <td>{String(value)}</td>
+                    </tr>
+                  ))}
+                {Object.values(parsed.supplies).every((value) => !value) && (
+                  <tr><td className="muted small">No supplies listed in this pattern.</td></tr>
+                )}
+              </tbody>
+            </table>
+            <div className="divider" />
+            <div className="row" style={{ gap: 16 }}>
+              <div className="stat">
+                <span className="value" style={{ fontSize: '1.2rem' }}>{yarn.metres} m</span>
+                <span className="label">estimated yarn</span>
+              </div>
+              <div className="stat">
+                <span className="value" style={{ fontSize: '1.2rem' }}>{yarn.skeins}</span>
+                <span className="label">skeins (200 m)</span>
+              </div>
+            </div>
+            <p className="tiny faint" style={{ marginTop: 8, marginBottom: 0 }}>{yarn.note}</p>
+          </div>
+
+          <div className="card">
+            <div className="card-title"><h3>Abbreviations used</h3></div>
+            <div className="grid" style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(140px, 1fr))', gap: 8 }}>
+              {parsed.abbreviations.map((code) => {
+                const stitch = findStitch(code);
+                return (
+                  <div className="row-tight" key={code} style={{ gap: 8 }}>
+                    <StitchSymbol code={code} size={22} />
+                    <div>
+                      <div className="small" style={{ fontWeight: 600 }}>{code}</div>
+                      <div className="tiny faint">{stitch?.name ?? 'unknown'}</div>
+                    </div>
+                  </div>
+                );
+              })}
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/web/studio/src/client/pages/Projects.tsx b/web/studio/src/client/pages/Projects.tsx
new file mode 100644
index 0000000..2b2fb55
--- /dev/null
+++ b/web/studio/src/client/pages/Projects.tsx
@@ -0,0 +1,404 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import type { Project } from '../../shared/types.ts';
+import { formatDuration } from '../../domain/checkerSummary.ts';
+import { useStore } from '../store.tsx';
+import { navigate, useRoute } from '../lib/router.ts';
+import { StepRow } from '../components/PatternBits.tsx';
+import { Chip, Modal, useToast } from '../components/ui.tsx';
+
+export function ProjectsPage() {
+  const { parts, query } = useRoute();
+  const { state } = useStore();
+  const toast = useToast();
+  const selectedId = parts[1] ?? query.get('project') ?? null;
+  const project = selectedId ? state.projects.find((p) => p.id === selectedId) : undefined;
+
+  const [showNew, setShowNew] = useState(false);
+  const [newTitle, setNewTitle] = useState('');
+  const [newRows, setNewRows] = useState(20);
+
+  const { startProject } = useStore();
+
+  if (project) return <ProjectDetail project={project} />;
+
+  const active = state.projects.filter((p) => p.status === 'wip');
+  const finished = state.projects.filter((p) => p.status === 'done');
+  const frogged = state.projects.filter((p) => p.status === 'frogged');
+
+  const create = () => {
+    const title = newTitle.trim() || 'Untitled project';
+    const total = Math.max(1, Math.min(500, Math.round(newRows)));
+    const steps = Array.from({ length: total }, (_, index) => ({
+      index,
+      label: `Row ${index + 1}`,
+      kind: 'row' as const,
+      instruction: `Row ${index + 1} - free-form rows, count as you go`,
+      computedCount: undefined as unknown as number,
+    }));
+    const created = startProject({ title, craft: 'crochet', steps });
+    setShowNew(false);
+    setNewTitle('');
+    setNewRows(20);
+    toast.show('Project created');
+    navigate(`/projects/${created.id}`);
+  };
+
+  return (
+    <div>
+      <div className="page-head">
+        <div className="eyebrow">Projects</div>
+        <h1>What is on your hook?</h1>
+        <p className="lead">
+          Every project keeps its own row counter, repeat counter and making time. Everything is saved
+          to this device the moment you tap, so closing the tab loses nothing.
+        </p>
+        <div className="row" style={{ marginTop: 14 }}>
+          <button className="btn primary" onClick={() => setShowNew(true)}>New project</button>
+          <button className="btn" onClick={() => navigate('/library')}>Start from a pattern</button>
+        </div>
+      </div>
+
+      {state.projects.length === 0 && (
+        <div className="empty">
+          <div className="big">🧶</div>
+          <h3>No projects yet</h3>
+          <p className="small">Start from a pattern in the library, or create a free-form counter.</p>
+          <button className="btn primary" onClick={() => setShowNew(true)}>New counter</button>
+        </div>
+      )}
+
+      {active.length > 0 && (
+        <section className="section" style={{ marginTop: 0 }}>
+          <div className="section-head"><h2>In progress</h2></div>
+          <div className="grid grid-3">
+            {active.map((item) => <ProjectCard key={item.id} project={item} />)}
+          </div>
+        </section>
+      )}
+
+      {finished.length > 0 && (
+        <section className="section">
+          <div className="section-head"><h2>Finished</h2><span className="chip sage">{finished.length}</span></div>
+          <div className="grid grid-3">
+            {finished.map((item) => <ProjectCard key={item.id} project={item} />)}
+          </div>
+        </section>
+      )}
+
+      {frogged.length > 0 && (
+        <section className="section">
+          <div className="section-head"><h2>Frogged</h2></div>
+          <div className="grid grid-3">
+            {frogged.map((item) => <ProjectCard key={item.id} project={item} />)}
+          </div>
+        </section>
+      )}
+
+      {showNew && (
+        <Modal
+          title="New project counter"
+          onClose={() => setShowNew(false)}
+          footer={
+            <>
+              <button className="btn ghost" onClick={() => setShowNew(false)}>Cancel</button>
+              <button className="btn primary" onClick={create}>Create</button>
+            </>
+          }
+        >
+          <div className="field">
+            <label htmlFor="project-title">Project name</label>
+            <input
+              id="project-title"
+              type="text"
+              value={newTitle}
+              onChange={(event) => setNewTitle(event.target.value)}
+              placeholder="e.g. Grey cardi sleeve"
+              autoFocus
+            />
+          </div>
+          <div className="field">
+            <label htmlFor="project-rows">How many rows do you expect?</label>
+            <input
+              id="project-rows"
+              type="number"
+              min={1}
+              max={500}
+              value={newRows}
+              onChange={(event) => setNewRows(Number(event.target.value))}
+            />
+            <span className="help">You can add more rows later. Free-form projects just count rows.</span>
+          </div>
+        </Modal>
+      )}
+    </div>
+  );
+}
+
+function ProjectCard({ project }: { project: Project }) {
+  const total = project.steps.filter((s) => s.kind === 'row' || s.kind === 'round').length;
+  const done = project.counts.completedSteps.length;
+  const percent = total > 0 ? Math.round((done / total) * 100) : 0;
+
+  return (
+    <button
+      className="card"
+      style={{ textAlign: 'left', cursor: 'pointer' }}
+      onClick={() => navigate(`/projects/${project.id}`)}
+    >
+      <div className="row-tight" style={{ marginBottom: 6 }}>
+        <Chip tone={project.status === 'done' ? 'sage' : project.status === 'frogged' ? 'rose' : 'mustard'}>
+          {project.status === 'wip' ? 'in progress' : project.status}
+        </Chip>
+        <span className="spacer" />
+        <span className="tiny faint">{formatDuration(project.elapsedSeconds)}</span>
+      </div>
+      <h4 style={{ margin: '0 0 8px', fontFamily: 'var(--font)' }}>{project.title}</h4>
+      <div className="meter"><i style={{ width: `${percent}%` }} /></div>
+      <div className="row-tight" style={{ marginTop: 6 }}>
+        <span className="tiny faint">{done}/{total} rows</span>
+        <span className="spacer" />
+        <span className="tiny faint">{percent}%</span>
+      </div>
+    </button>
+  );
+}
+
+function ProjectDetail({ project }: { project: Project }) {
+  const { completeStep, updateProject, deleteProject, addElapsed } = useStore();
+  const toast = useToast();
+  const [running, setRunning] = useState(false);
+  const [confirmDelete, setConfirmDelete] = useState(false);
+  const timer = useRef<number | null>(null);
+
+  const rows = project.steps.filter((s) => s.kind === 'row' || s.kind === 'round');
+  const done = project.counts.completedSteps.length;
+  const nextStep = rows.find((step) => !project.counts.completedSteps.includes(step.index));
+  const percent = rows.length > 0 ? Math.round((done / rows.length) * 100) : 0;
+
+  // Making-time tracker: one tick per second while running.
+  useEffect(() => {
+    if (!running) return;
+    timer.current = window.setInterval(() => addElapsed(project.id, 1), 1000);
+    return () => {
+      if (timer.current !== null) window.clearInterval(timer.current);
+    };
+  }, [running, addElapsed, project.id]);
+
+  const setCounts = (patch: Partial<Project['counts']>) => {
+    updateProject(project.id, { counts: { ...project.counts, ...patch } });
+  };
+
+  const markNext = () => {
+    if (!nextStep) {
+      toast.show('Every row is already ticked');
+      return;
+    }
+    completeStep(project.id, nextStep.index, rows.length);
+  };
+
+  const undo = () => {
+    const last = [...project.counts.completedSteps].sort((a, b) => b - a)[0];
+    if (last === undefined) return;
+    completeStep(project.id, last, rows.length);
+  };
+
+  const repeatTarget = useMemo(() => nextStep?.repeat ?? null, [nextStep]);
+
+  return (
+    <div>
+      <button className="btn ghost sm" onClick={() => navigate('/projects')} style={{ marginBottom: 12 }}>
+        ← All projects
+      </button>
+
+      <div className="page-head">
+        <div className="row-tight" style={{ marginBottom: 8 }}>
+          <Chip tone={project.status === 'done' ? 'sage' : 'mustard'}>
+            {project.status === 'wip' ? 'in progress' : project.status}
+          </Chip>
+          <Chip outline>{project.craft}</Chip>
+          {project.hook && <Chip outline>hook {project.hook}</Chip>}
+        </div>
+        <h1 style={{ marginBottom: 4 }}>{project.title}</h1>
+        <p className="lead">
+          {done} of {rows.length} rows complete · {formatDuration(project.elapsedSeconds)} of making time
+        </p>
+        <div className="meter" style={{ maxWidth: 420, marginTop: 12 }}>
+          <i style={{ width: `${percent}%` }} />
+        </div>
+      </div>
+
+      <div className="split">
+        <div className="stack">
+          <div className="card">
+            <div className="card-title">
+              <h3>Row counter</h3>
+              <span className="meta">{running ? 'timer running' : 'timer paused'}</span>
+            </div>
+            <div className="counter-display">
+              <div className="value">{project.counts.stitchCount}</div>
+              <div className="caption">stitches in this row</div>
+            </div>
+            <div className="counter-pad" style={{ marginTop: 12 }}>
+              <button className="btn" onClick={() => setCounts({ stitchCount: project.counts.stitchCount + 1 })}>
+                + 1 stitch
+              </button>
+              <button className="btn" onClick={() => setCounts({ stitchCount: Math.max(0, project.counts.stitchCount - 1) })}>
+                − 1 stitch
+              </button>
+              <button className="btn" onClick={() => setCounts({ repeatCount: project.counts.repeatCount + 1 })}>
+                Repeat + 1
+              </button>
+              <button className="btn" onClick={() => setCounts({ stitchCount: 0, repeatCount: 0 })}>
+                Reset row
+              </button>
+            </div>
+
+            <div className="divider" />
+
+            <div className="row" style={{ gap: 10 }}>
+              <button className="btn primary" style={{ flex: 1 }} onClick={markNext}>
+                Complete {nextStep?.label ?? 'all rows'}
+              </button>
+              <button className="btn" onClick={undo} disabled={done === 0}>Undo</button>
+            </div>
+            <p className="tiny faint" style={{ marginTop: 8, marginBottom: 0 }}>
+              {repeatTarget
+                ? `Next row is a ${repeatTarget.times}x repeat of a ${repeatTarget.groupMade}-stitch group.`
+                : nextStep
+                  ? `${nextStep.label}: ${nextStep.instruction.slice(0, 90)}${nextStep.instruction.length > 90 ? '…' : ''}`
+                  : 'All rows are complete - congratulations.'}
+            </p>
+
+            <div className="divider" />
+
+            <div className="row" style={{ gap: 10 }}>
+              <div className="stat">
+                <span className="value" style={{ fontSize: '1.3rem' }}>{project.counts.repeatCount}</span>
+                <span className="label">repeats this row</span>
+              </div>
+              <div className="stat">
+                <span className="value" style={{ fontSize: '1.3rem' }}>{formatDuration(project.elapsedSeconds)}</span>
+                <span className="label">making time</span>
+              </div>
+              <span className="spacer" />
+              <button className={`btn sm ${running ? 'dark' : ''}`} onClick={() => setRunning((value) => !value)}>
+                {running ? '⏸ Pause timer' : '▶ Start timer'}
+              </button>
+            </div>
+          </div>
+
+          <div className="card">
+            <div className="card-title">
+              <h3>Rows</h3>
+              <span className="meta">{done} done</span>
+            </div>
+            <div className="steps">
+              {project.steps.slice(0, 60).map((step) => (
+                <StepRow
+                  key={step.index}
+                  step={step}
+                  done={project.counts.completedSteps.includes(step.index)}
+                  onToggle={() => completeStep(project.id, step.index, rows.length)}
+                />
+              ))}
+            </div>
+            {project.steps.length > 60 && (
+              <p className="tiny faint" style={{ marginTop: 10 }}>Showing the first 60 rows.</p>
+            )}
+          </div>
+        </div>
+
+        <div className="stack">
+          <div className="card">
+            <div className="card-title"><h3>Details</h3></div>
+            <div className="field">
+              <label htmlFor="p-yarn">Yarn</label>
+              <input
+                id="p-yarn"
+                type="text"
+                value={project.yarn ?? ''}
+                placeholder="e.g. Stylecraft Special DK, silver"
+                onChange={(event) => updateProject(project.id, { yarn: event.target.value })}
+              />
+            </div>
+            <div className="field">
+              <label htmlFor="p-hook">Hook / needle</label>
+              <input
+                id="p-hook"
+                type="text"
+                value={project.hook ?? ''}
+                placeholder="e.g. 4.0 mm"
+                onChange={(event) => updateProject(project.id, { hook: event.target.value })}
+              />
+            </div>
+            <div className="field">
+              <label htmlFor="p-status">Status</label>
+              <select
+                id="p-status"
+                value={project.status}
+                onChange={(event) => updateProject(project.id, { status: event.target.value as Project['status'] })}
+              >
+                <option value="wip">In progress</option>
+                <option value="done">Finished</option>
+                <option value="frogged">Frogged</option>
+              </select>
+            </div>
+            <div className="field" style={{ marginBottom: 0 }}>
+              <label htmlFor="p-notes">Notes</label>
+              <textarea
+                id="p-notes"
+                className="prose"
+                value={project.notes}
+                placeholder="Hook changes, modifications, where you left the hook…"
+                onChange={(event) => updateProject(project.id, { notes: event.target.value })}
+                style={{ minHeight: 100 }}
+              />
+            </div>
+          </div>
+
+          {project.patternId && (
+            <div className="card">
+              <div className="card-title"><h3>Pattern</h3></div>
+              <button className="btn block" onClick={() => navigate(`/pattern/${project.patternId}`)}>
+                Open the pattern
+              </button>
+            </div>
+          )}
+
+          <div className="card">
+            <div className="card-title"><h3>Danger zone</h3></div>
+            <button className="btn danger block" onClick={() => setConfirmDelete(true)}>
+              Delete this project
+            </button>
+          </div>
+        </div>
+      </div>
+
+      {confirmDelete && (
+        <Modal
+          title="Delete this project?"
+          onClose={() => setConfirmDelete(false)}
+          footer={
+            <>
+              <button className="btn ghost" onClick={() => setConfirmDelete(false)}>Keep it</button>
+              <button
+                className="btn danger"
+                onClick={() => {
+                  deleteProject(project.id);
+                  navigate('/projects');
+                }}
+              >
+                Delete
+              </button>
+            </>
+          }
+        >
+          <p className="small">
+            The project, its row ticks and its making time will be removed from this device. This cannot
+            be undone.
+          </p>
+        </Modal>
+      )}
+    </div>
+  );
+}
diff --git a/web/studio/src/client/pages/Settings.tsx b/web/studio/src/client/pages/Settings.tsx
new file mode 100644
index 0000000..f0cf25e
