+const BY_ALIAS = new Map<string, StitchDefinition>();
+for (const stitch of STITCHES) {
+  BY_ALIAS.set(stitch.code, stitch);
+  for (const alias of stitch.aliases) BY_ALIAS.set(alias, stitch);
