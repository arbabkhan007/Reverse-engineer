+                ))}
+              </div>
+            )}
+          </div>
+        </div>
+
+        <div className="stack">
+          <div className="card">
+            <div className="card-title">
+              <h3>Python engine</h3>
+              {engine?.available ? <Chip tone="sage">connected</Chip> : <Chip outline>offline</Chip>}
