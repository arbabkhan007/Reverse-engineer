+++ b/web/studio/package.json
@@ -0,0 +1,31 @@
+{
+  "name": "crochet-studio",
+  "version": "1.0.0",
+  "private": true,
+  "description": "Crochet Studio - a web companion for the Crochet Pattern Checker: pattern library, row counter, PDF/web import, stitch identification, pattern canvas, and courses. The Python checker remains the authoritative engine.",
+  "type": "module",
+  "scripts": {
+    "dev": "node --experimental-strip-types src/server/dev.ts",
+    "build": "vite build",
+    "start": "node --experimental-strip-types src/server/index.ts",
+    "typecheck": "tsc --noEmit",
+    "test": "vitest run",
+    "test:watch": "vitest"
+  },
+  "dependencies": {
+    "express": "^4.19.2",
+    "pdfjs-dist": "^4.7.76",
+    "react": "^18.3.1",
+    "react-dom": "^18.3.1"
+  },
+  "devDependencies": {
+    "@types/express": "^4.17.21",
+    "@types/node": "^22.7.5",
+    "@types/react": "^18.3.11",
+    "@types/react-dom": "^18.3.0",
+    "@vitejs/plugin-react": "^4.3.2",
+    "typescript": "^5.6.3",
+    "vite": "^5.4.9",
+    "vitest": "^2.1.3"
+  }
+}
diff --git a/web/studio/src/client/App.tsx b/web/studio/src/client/App.tsx
new file mode 100644
index 0000000..1ec66c7
--- /dev/null
+++ b/web/studio/src/client/App.tsx
@@ -0,0 +1,78 @@
+import { useRoute } from './lib/router.ts';
+import { HomePage } from './pages/Home.tsx';
+import { LibraryPage } from './pages/Library.tsx';
+import { PatternViewPage } from './pages/PatternView.tsx';
+import { CheckerPage } from './pages/Checker.tsx';
+import { ConverterPage } from './pages/Converter.tsx';
+import { ProjectsPage } from './pages/Projects.tsx';
+import { StitchIdPage } from './pages/StitchId.tsx';
+import { CanvasPage } from './pages/Canvas.tsx';
+import { CoursesPage } from './pages/Courses.tsx';
+import { SettingsPage } from './pages/Settings.tsx';
+
+const NAV = [
+  { href: '/library', label: 'Patterns' },
+  { href: '/checker', label: 'Checker' },
+  { href: '/converter', label: 'Converter' },
+  { href: '/projects', label: 'Projects' },
+  { href: '/stitch-id', label: 'Stitch ID' },
+  { href: '/canvas', label: 'Canvas' },
+  { href: '/courses', label: 'Learn' },
+];
+
+export function App() {
+  const { path, parts } = useRoute();
+  const root = parts[0] ?? '';
+
+  let page = <HomePage />;
+  if (root === 'library') page = <LibraryPage />;
+  else if (root === 'pattern') page = <PatternViewPage />;
+  else if (root === 'checker') page = <CheckerPage />;
+  else if (root === 'converter') page = <ConverterPage />;
+  else if (root === 'projects') page = <ProjectsPage />;
+  else if (root === 'stitch-id') page = <StitchIdPage />;
+  else if (root === 'canvas') page = <CanvasPage />;
+  else if (root === 'courses') page = <CoursesPage />;
+  else if (root === 'settings') page = <SettingsPage />;
+
+  return (
+    <div className="app">
+      <a href="#main" className="btn ghost sm" style={{ position: 'absolute', left: -9999 }}>Skip to content</a>
+      <header className="topbar">
+        <div className="topbar-inner">
