{
  "name": "@rea/yarncraft",
  "version": "1.0.0",
  "private": true,
  "description": "Crochet Studio - a web companion for the Crochet Pattern Checker: pattern library, row counter, PDF/web import, stitch identification, pattern canvas, and courses. The Python checker remains the authoritative engine.",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/server/dev.ts",
    "build": "vite build",
    "start": "node --experimental-strip-types src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
